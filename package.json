{
  "name": "ojo-selfhost",
  "private": true,
  "description": "A powerful HTML-to-image API service. Perfect for developers, agencies, and organizations who need dynamic image generation with full control over their infrastructure.",
  "keywords": [
    "api",
    "screenshot",
    "automation",
    "self-hosted",
    "html-to-pdf",
    "html-to-image"
  ],
  "homepage": "https://ojo.so",
  "bugs": {
    "url": "https://github.com/ojodotso/self-host/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ojodotso/self-host.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "oJo",
    "email": "hello@ojo.so",
    "url": "https://ojo.so"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "depcheck": "depcheck",
    "check": "turbo check",
    "clean:sub": "rimraf --glob \"apps/**/node_modules\" \"packages/**/node_modules\" \"**/build\" \"**/.next\" \"**/.turbo\"",
    "clean": "pnpm i rimraf -D --workspace-root && pnpm clean:sub && rimraf node_modules"
  },
  "devDependencies": {
    "@ojo/eslint-config": "workspace:*",
    "@ojo/typescript-config": "workspace:*",
    "rimraf": "6.0.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "depcheck": "^1.4.7",
    "prettier": "^3.6.2",
    "semantic-release": "^24.2.9",
    "turbo": "latest"
  },
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0"
    }
  }
}
